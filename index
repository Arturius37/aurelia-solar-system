.toast.show{opacity:1}
</style>
</head>
<body>
<canvas id="scene"></canvas>
<div id="labels"></div>

<div id="intro">
  <div class="intro-kicker">Cinematic Orbital Simulation</div>
  <h1 class="intro-title">AURELIA</h1>
  <p class="intro-sub">The Sun and its ten worlds, rendered in real time with true orbital periods. Drag to orbit, scroll to zoom, click any world to fly in close.</p>
  <button id="enter-btn">Enter the System →</button>
  <div class="intro-bar"><div class="intro-bar-fill" id="bar-fill"></div></div>
  <div class="intro-pct" id="bar-pct">GENERATING SURFACES · 0%</div>
</div>

<div class="hud" id="top-hud">
  <div>
    <div class="brand">AUR<span>E</span>LIA</div>
    <div class="tagline">Solar System Explorer</div>
    <div class="hint">Drag to rotate · scroll / pinch to zoom · click a world to approach · click empty space or press Esc to return · ← → to cycle</div>
  </div>
  <div class="glass badge"><span class="fps" id="fps">-- fps</span></div>
</div>

<div class="hud glass" id="controls">
  <div class="ctrl-row" style="justify-content:space-between">
    <span class="hud-label">Time Rate</span>
    <div style="display:flex;gap:6px">
      <button class="icon-btn on" id="btn-pause" title="Pause / Play (Space)">⏸</button>
      <button class="icon-btn" id="btn-reset" title="Reset view (Esc)">↺</button>
      <button class="icon-btn on" id="btn-orbits" title="Orbit lines">⊙</button>
      <button class="icon-btn on" id="btn-labels" title="Labels">Aa</button>
    </div>
  </div>
  <div class="ctrl-row"><input type="range" id="speed" min="0" max="5" step="1" value="2"></div>
  <div class="speed-lbl" id="speed-lbl">1 week / second</div>
  <div class="sim-time mob-hide">Simulated date · <b id="sim-date">—</b></div>
  <div class="hud-label mob-hide">Scale</div>
  <div class="mode-toggle mob-hide"><div class="mode-opt active" id="mode-visual">Cinematic</div><div class="mode-opt" id="mode-real">Proportional</div></div>
</div>

<div class="hud glass" id="planet-nav"></div>

<div class="hud glass" id="info">
  <button class="info-close" id="info-close" aria-label="Close">✕</button>
  <div class="info-type" id="i-type"></div>
  <h2 class="info-name" id="i-name"></h2>
  <div class="info-sub" id="i-sub"></div>
  <p class="info-desc" id="i-desc"></p>
  <div class="stat-grid" id="i-stats"></div>
  <div class="info-fact" id="i-fact"></div>
</div>
<div class="toast" id="toast"></div>

