var clock=new THREE.Clock(),fr=0,ft=0,START=Date.UTC(2026,8,28),tv=new THREE.Vector3(),fpsEl=el("fps"),dateEl=el("sim-date"),tanH=Math.tan(camera.fov*Math.PI/360);
function animate(){requestAnimationFrame(animate);var dt=Math.min(clock.getDelta(),.05),rate=SPEEDS[spIdx].v,k=Math.min(dt*2.2,1);
if(!paused)simDays+=dt*rate;
BODIES.forEach(function(b){var h=holders[b.key],m=meshes[b.key],d=scaleMode==="visual"?b.vD:b.rD,r=scaleMode==="visual"?b.vR:b.rR;
h.position.x+=(d-h.position.x)*k;m.scale.setScalar(m.scale.x+(r-m.scale.x)*k);
if(b.key!=="sun")pivots[b.key].rotation.y=b.ph+TAU*simDays/b.orbit;
if(!b.lock&&!paused)m.rotation.y+=Math.min(TAU/b.rot*rate,.5)*dt});
if(clouds&&!paused)clouds.rotation.y+=.02*dt*Math.min(rate,10)/3;
sunMat.uniforms.time.value+=dt*(paused?0:1)+.0001;
var bs=scaleMode==="visual"?1:.71;belt.scale.setScalar(belt.scale.x+(bs-belt.scale.x)*k);belt.rotation.y=TAU*simDays/1650;
Object.keys(orbitLines).forEach(function(kk){var b=BODIES.filter(function(x){return x.key===kk})[0],s=(scaleMode==="visual"?b.vD:b.rD)/b.vD,o=orbitLines[kk];o.scale.setScalar(o.scale.x+(s-o.scale.x)*k)});
if(fly){fly.t+=dt/fly.dur;var e=ease(Math.min(fly.t,1));camera.position.lerpVectors(fly.p0,fly.gp(),e);controls.target.lerpVectors(fly.t0,fly.gt(),e);if(fly.t>=1){fly=null;controls.enabled=true}}
else if(selected){meshes[selected].getWorldPosition(wp);tv.copy(wp).sub(controls.target);camera.position.add(tv);controls.target.copy(wp)}
controls.update();renderer.render(scene,camera);
/* labels */
BODIES.forEach(function(b){var l=labelEls[b.key],m=meshes[b.key];m.getWorldPosition(tv);var dc=tv.distanceTo(camera.position),v=tv.clone().project(camera),show=showLbl&&v.z<1&&v.z>-1;
if(b.key==="moon")show=show&&dc<22;if(show&&selected&&selected!==b.key&&dc<m.scale.x*2)show=false;
if(!show){l.style.opacity=0;return}
var ry=m.scale.x/dc*innerHeight/2/tanH;l.style.opacity=1;l.style.transform="translate("+(((v.x*.5+.5)*innerWidth)+8).toFixed(1)+"px,"+(((-v.y*.5+.5)*innerHeight)-Math.min(ry,60)-16).toFixed(1)+"px)"});
dateEl.textContent=new Date(START+simDays*864e5).toLocaleDateString("en-US",{year:"numeric",month:"short",day:"numeric",timeZone:"UTC"});
fr++;ft+=dt;if(ft>=.5){fpsEl.textContent=Math.round(fr/ft)+" fps";fr=0;ft=0}}

/* ============ BOOT: synthesize surfaces with real progress ============ */
var names=["earth","clouds","mars","moon","mercury","jupiter","venus","saturn","uranus","neptune"];
names.forEach(function(n){totalRows+=SIZE[n][1]});
(async function(){
for(var i=0;i<names.length;i++){var n=names[i],s=SIZE[n],t=await gen(s[0],s[1],STYLE[n]);
if(n==="mars"){craters(t,90,3,16);t.craterd=1}if(n==="moon"){craters(t,320,2,26);t.craterd=1}if(n==="mercury"){craters(t,300,2,22);t.craterd=1}TEX[n]=t}
build();animate();
var b=el("enter-btn");b.classList.add("ready");barPct.textContent="READY";
b.onclick=function(){el("intro").classList.add("hide");overview()}})();
})();
</script>
