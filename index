.brand{font-size:19px;font-weight:600;letter-spacing:.08em}.brand span{color:var(--gold)}
.tagline{font-size:10.5px;color:var(--dim);letter-spacing:.24em;text-transform:uppercase;margin-top:3px}
.hint{font-size:10.5px;color:var(--dim);margin-top:8px;max-width:250px;line-height:1.6;font-weight:300;display:none}
