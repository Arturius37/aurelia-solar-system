.nav-item:hover{background:rgba(255,255,255,.05)}
.nav-item.active{background:var(--gold-dim);border-color:rgba(217,165,72,.4)}
.nav-dot{width:12px;height:12px;border-radius:50%;box-shadow:0 0 10px currentColor}
.nav-name{font-size:9.5px;letter-spacing:.06em;color:var(--dim);text-transform:uppercase;white-space:nowrap}
.nav-item.active .nav-name{color:var(--gold)}
